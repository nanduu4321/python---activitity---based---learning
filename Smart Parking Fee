entry = int(input("Entry hour (0-23): "))
exit = int(input("Exit hour (0-23): "))
vehicle = input("Vehicle (bike/car/bus): ")

hours = exit - entry
if hours < 0:
    hours += 24

if vehicle == "bike":
    rate = 10
elif vehicle == "car":
    rate = 20
else:
    rate = 40

bill = hours * rate
print("Parking Hours =", hours)
print("Parking Fee =", bill)
